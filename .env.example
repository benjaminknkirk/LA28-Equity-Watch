# Copy to .env and fill in. Never commit .env.

# Free Census Bureau API key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Healthy Places Index API key (create account at https://map.healthyplacesindex.org/)
# See: https://api.healthyplacesindex.org/
HPI_API_KEY=

# Optional Nominatim User-Agent contact for geocoding
GEOCODER_USER_AGENT=LA28-Equity-Watch/0.1 (research; contact: YOUR_EMAIL)